# ============================================
# scripts/training_utils.py
#
# Correct loss / inference / optimizer behavior for the
# four corrected backbones.
# ============================================

from __future__ import annotations

import numpy as np
import torch
import torch.nn.functional as F

from scripts.config import (
    DEVICE,
    resnet_config,
    ft_config,
    tabm_config,
    xgb_config,
)
from scripts.models import (
    ResNetMLP,
    FTTransformer,
    TabM,
    make_xgboost,
)


# ============================================
# Model construction
# ============================================
def build_torch_model(name: str, config=None):
    name = name.lower()

    if name in {"resnet", "resnet_mlp", "resnet-mlp"}:
        return ResNetMLP(config).to(DEVICE)

    if name in {"ft", "ft_transformer", "ft-transformer"}:
        return FTTransformer(config).to(DEVICE)

    if name == "tabm":
        return TabM(config).to(DEVICE)

    raise ValueError(f"Unknown torch backbone: {name}")


# ============================================
# Optimizers
# ============================================
def build_optimizer(name: str, model):
    name = name.lower()

    if name in {"resnet", "resnet_mlp", "resnet-mlp"}:
        return torch.optim.AdamW(
            model.parameters(),
            lr=resnet_config.lr,
            weight_decay=resnet_config.weight_decay,
        )

    if name in {"ft", "ft_transformer", "ft-transformer"}:
        # Important: FT-Transformer has parameter groups that should
        # not all receive weight decay.
        return torch.optim.AdamW(
            model.make_parameter_groups(),
            lr=ft_config.lr,
            weight_decay=ft_config.weight_decay,
        )

    if name == "tabm":
        return torch.optim.AdamW(
            model.parameters(),
            lr=tabm_config.lr,
            weight_decay=tabm_config.weight_decay,
        )

    raise ValueError(f"Unknown torch backbone: {name}")


# ============================================
# Losses
# ============================================
def tabm_cross_entropy(logits: torch.Tensor, target: torch.Tensor) -> torch.Tensor:
    """
    logits: (B, K, C)
    target: (B,)

    Correct TabM objective:
        mean_k CE(logits[:, k, :], target)

    WRONG:
        CE(mean_k logits[:, k, :], target)
    """
    if logits.ndim != 3:
        raise ValueError(
            f"TabM logits must have shape (B,K,C), got {tuple(logits.shape)}"
        )

    target = target.long().reshape(-1)
    b, k, c = logits.shape

    if target.shape[0] != b:
        raise ValueError("Target batch size does not match logits.")

    target_k = target[:, None].expand(-1, k)

    return F.cross_entropy(
        logits.reshape(b * k, c),
        target_k.reshape(b * k),
        reduction="mean",
    )


def classification_loss(name: str, logits: torch.Tensor, target: torch.Tensor):
    name = name.lower()

    if name == "tabm":
        return tabm_cross_entropy(logits, target)

    return F.cross_entropy(logits, target.long())


# ============================================
# Probability / prediction helpers
# ============================================
def logits_to_proba(name: str, logits: torch.Tensor) -> torch.Tensor:
    name = name.lower()

    if name == "tabm":
        # Correct classification inference for TabM:
        # member logits -> member probabilities -> mean probabilities.
        return torch.softmax(logits, dim=-1).mean(dim=1)

    return torch.softmax(logits, dim=-1)


def logits_to_prediction(name: str, logits: torch.Tensor) -> torch.Tensor:
    return logits_to_proba(name, logits).argmax(dim=-1)


# ============================================
# Generic one-epoch PyTorch trainer
# ============================================
def train_one_epoch(name, model, loader, optimizer, device=DEVICE):
    model.train()

    total_loss = 0.0
    n_samples = 0

    for x, y in loader:
        x = x.to(device, non_blocking=True).float()
        y = y.to(device, non_blocking=True).long()

        optimizer.zero_grad(set_to_none=True)

        logits = model(x)
        loss = classification_loss(name, logits, y)

        loss.backward()
        optimizer.step()

        batch_size = x.shape[0]
        total_loss += loss.item() * batch_size
        n_samples += batch_size

    return total_loss / max(n_samples, 1)


@torch.no_grad()
def evaluate_torch(name, model, loader, device=DEVICE):
    model.eval()

    total_loss = 0.0
    n_samples = 0
    n_correct = 0

    for x, y in loader:
        x = x.to(device, non_blocking=True).float()
        y = y.to(device, non_blocking=True).long()

        logits = model(x)
        loss = classification_loss(name, logits, y)
        pred = logits_to_prediction(name, logits)

        batch_size = x.shape[0]
        total_loss += loss.item() * batch_size
        n_samples += batch_size
        n_correct += (pred == y).sum().item()

    return {
        "loss": total_loss / max(n_samples, 1),
        "accuracy": n_correct / max(n_samples, 1),
    }


# ============================================
# XGBoost
# ============================================
def train_xgboost(
    X_train,
    y_train,
    X_valid,
    y_valid,
    config=xgb_config,
    seed: int = 42,
):
    """
    X_train/X_valid:
        numpy arrays or pandas DataFrames

    y_train/y_valid:
        integer labels in {0, ..., num_classes - 1}
    """
    model = make_xgboost(config=config, seed=seed)

    model.fit(
        X_train,
        y_train,
        eval_set=[(X_valid, y_valid)],
        verbose=False,
    )

    return model


def evaluate_xgboost(model, X, y):
    proba = model.predict_proba(X)
    pred = np.argmax(proba, axis=1)

    y = np.asarray(y)
    accuracy = float(np.mean(pred == y))

    # Stable multiclass log loss without requiring sklearn.
    eps = np.finfo(np.float64).eps
    p_true = np.clip(proba[np.arange(len(y)), y.astype(int)], eps, 1.0)
    logloss = float(-np.mean(np.log(p_true)))

    return {
        "loss": logloss,
        "accuracy": accuracy,
    }
